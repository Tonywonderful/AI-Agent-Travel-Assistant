# Chat LLM：默认保留原 OpenAI-compatible 配置
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen3.7-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# OpenCode Zen 限时免费模型（与上方配置二选一）
# LLM_PROVIDER=opencode_zen
# LLM_MODEL=deepseek-v4-flash-free
# OPENCODE_API_KEY=public
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# 可选模型：big-pickle、deepseek-v4-flash-free、mimo-v2.5-free、
# north-mini-code-free、nemotron-3-ultra-free

# RAG / Chroma
CHROMA_DB_DIR=db/chroma_db
CHROMA_COLLECTION_NAME=travel_guides
# embedding: openai_compatible（云端）或 ollama（本地）
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=qwen3.7-text-embedding
# 本地 Ollama 示例：
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=qwen3-embedding:4b
# OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embeddings
# 可选：embedding 单独 key/base；普通兼容 Provider 不填时复用 LLM_*
# 使用 opencode_zen 时必须单独配置，或改用上方本地 Ollama 示例
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# OpenRouter Rerank（使用独立 Key，不复用 LLM_API_KEY）
RERANK_API_URL=https://openrouter.ai/api/v1/rerank
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANK_API_KEY=your_openrouter_api_key
RERANK_TIMEOUT_SECONDS=30
# 以下两个请求头可选，用于 OpenRouter 应用排名与标识
# RERANK_HTTP_REFERER=http://localhost:5173
# RERANK_APP_TITLE=TravelPlanAssistant
EMBEDDING_BATCH_SIZE=10
# 最终返回的攻略片段数；向量召回候选数为 max(RAG_TOP_K * 2, 6)
RAG_TOP_K=5

# Redis / Cache
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=trip_planner
REDIS_DEFAULT_TTL_SECONDS=1800
REDIS_WEATHER_TTL_SECONDS=1800
REDIS_MAP_TTL_SECONDS=86400
REDIS_RAG_TTL_SECONDS=21600
REDIS_RERANK_TTL_SECONDS=21600

# Amap / Gaode Map
AMAP_API_KEY=your_amap_api_key
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_DEFAULT_CITY=
AMAP_TIMEOUT_SECONDS=20
ENABLE_AMAP_ENRICHMENT=false

# Web Search（OpenCode 同款 Exa MCP；可不配 key 走免费端点）
# EXA_MCP_URL=https://mcp.exa.ai/mcp
# EXA_API_KEY=
# EXA_SEARCH_TIMEOUT_SECONDS=25
# WEB_SEARCH_DEFAULT_NUM_RESULTS=5
# WEB_SEARCH_CONTEXT_MAX_CHARS=8000
